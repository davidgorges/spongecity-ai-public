{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "*",
        "mcp/sdk": "^0.9.0",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-anthropic-platform": "^1.0@beta",
        "symfony/ai-bundle": "1.0.0-BETA1",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/asset": "8.2.*",
        "symfony/asset-mapper": "8.2.*",
        "symfony/console": "8.2.*",
        "symfony/doctrine-messenger": "8.2.*",
        "symfony/dotenv": "8.2.*",
        "symfony/expression-language": "8.2.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-client": "8.2.*",
        "symfony/lock": "8.2.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/mercure-bundle": "*",
        "symfony/messenger": "8.2.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "8.2.*",
        "symfony/property-access": "8.2.*",
        "symfony/property-info": "8.2.*",
        "symfony/rate-limiter": "8.2.*",
        "symfony/runtime": "8.2.*",
        "symfony/security-bundle": "8.2.*",
        "symfony/serializer": "8.2.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/translation": "8.2.*",
        "symfony/twig-bundle": "8.2.*",
        "symfony/uid": "8.2.*",
        "symfony/ux-icons": "^3.7",
        "symfony/ux-live-component": "^3.7",
        "symfony/ux-turbo": "^3.7",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "8.2.*",
        "symfony/workflow": "8.2.*",
        "symfony/yaml": "8.2.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.5",
        "twig/extra-bundle": "^3.29",
        "twig/html-extra": "^3.29",
        "twig/string-extra": "^3.24",
        "webmozart/assert": "^2.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Core\\": "lib/Core"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "tailwind:build": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.2.*",
        "symfony/css-selector": "8.2.*",
        "symfony/debug-bundle": "8.2.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.2.*",
        "symfony/ux-toolkit": "^3.7",
        "symfony/web-profiler-bundle": "8.2.*"
    }
}
