{#
    A window over the 3D view (window_manager_controller.js): a title bar to drag it by, minimise
    and close, its content below. Embedded by the workspace:

        {% embed 'plan/_window.html.twig' with {id: 'chat', title: …, icon: 'lucide:…', place: 'left top'} %}
            {% block actions %}…buttons beside the title…{% endblock %}
            {% block content %}…{% endblock %}
        {% endembed %}

    place: where it opens first (left|right and top|bottom, or "below <id>" of another window);
    open: whether it is open before the person decides; auto: a value that opens it whenever it
    changes to a non-empty one (an object being selected); width: its width on large screens.
#}
{% set open = open ?? true %}
{% set width = width ?? 'lg:w-96' %}
<section
    id="window-{{ id }}"
    class="flex min-h-0 flex-col bg-card lg:absolute lg:z-20 lg:max-h-[calc(100vh-8rem)] lg:overflow-hidden lg:rounded-xl lg:border lg:border-border lg:shadow-lg {{ width }}"
    aria-labelledby="window-{{ id }}-title"
    data-window-manager-target="window"
    data-window="{{ id }}"
    data-window-place="{{ place }}"
    data-window-open="{{ open ? 'true' : 'false' }}"
    {% if auto is defined %}data-window-auto="{{ auto }}"{% endif %}
    data-action="pointerdown->window-manager#raise focusin->window-manager#raise"
>
    <header class="flex items-center gap-2 border-b border-border px-3 py-2 lg:cursor-grab lg:select-none lg:active:cursor-grabbing" data-action="pointerdown->window-manager#grab">
        {% set move_label = 'plan.windows.move'|trans({'%title%': title}, 'spongecity') %}
        <twig:Button variant="ghost" size="icon-xs" class="hidden text-muted-foreground lg:inline-flex" title="{{ move_label }}" aria-label="{{ move_label }}" data-action="keydown->window-manager#nudge" data-window-manager-id-param="{{ id }}">
            <twig:ux:icon name="lucide:grip-vertical" aria-hidden="true" />
        </twig:Button>
        <h2 id="window-{{ id }}-title" class="flex min-w-0 flex-1 items-center gap-2 font-heading text-sm font-semibold">
            <twig:ux:icon name="{{ icon }}" class="size-4 shrink-0 text-primary" aria-hidden="true" />
            <span class="truncate">{{ title }}</span>
        </h2>
        {% block actions %}{% endblock %}
        {% set minimise_label = 'plan.windows.minimise'|trans({'%title%': title}, 'spongecity') %}
        <twig:Button variant="ghost" size="icon-xs" class="hidden lg:inline-flex" title="{{ minimise_label }}" aria-label="{{ minimise_label }}" aria-expanded="true" aria-controls="window-{{ id }}-body" data-window-manager-target="minimise" data-action="window-manager#minimise" data-window-manager-id-param="{{ id }}">
            <twig:ux:icon name="lucide:minus" aria-hidden="true" />
        </twig:Button>
        {% set close_label = 'plan.windows.close'|trans({'%title%': title}, 'spongecity') %}
        <twig:Button variant="ghost" size="icon-xs" class="hidden lg:inline-flex" title="{{ close_label }}" aria-label="{{ close_label }}" data-action="window-manager#close" data-window-manager-id-param="{{ id }}">
            <twig:ux:icon name="lucide:x" aria-hidden="true" />
        </twig:Button>
    </header>
    <div id="window-{{ id }}-body" class="flex min-h-0 flex-col gap-3 overflow-y-auto p-4" data-window-body>
        {% block content %}{% endblock %}
    </div>
</section>
