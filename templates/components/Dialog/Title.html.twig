{# @block content The title text of the dialog #}
<h2
    id="{{ _dialog_title_id }}"
    class="{{ ('font-heading text-base leading-none font-semibold tracking-tight ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.without('id', 'class') }}
>
    {%- block content %}{% endblock -%}
</h2>
