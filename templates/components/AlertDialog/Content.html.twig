{# @block content The dialog content, typically includes `AlertDialog:Header` and `AlertDialog:Footer` #}
<dialog
    id="{{ _alert_dialog_id }}"
    class="{{ ('text-foreground bg-background fixed top-[50%] left-[50%] bottom-auto right-auto z-50 h-auto w-full max-w-[calc(100%-2rem)] translate-x-[-50%] translate-y-[-50%] scale-95 gap-3 rounded-lg border p-5 opacity-0 shadow-lg transition-all transition-discrete duration-200 backdrop:transition-discrete backdrop:duration-150 open:grid open:scale-100 open:opacity-100 open:backdrop:bg-black/50 sm:max-w-lg starting:open:scale-95 starting:open:opacity-0 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({'data-alert-dialog-target': 'dialog', 'data-action': 'keydown.esc->alert-dialog#close:prevent'}).without('id', 'class') }}
>
    {%- block content %}{% endblock -%}
</dialog>
