{% extends 'base.html.twig' %}

{% block body %}
    <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-8 px-4 py-16">
        <header class="flex flex-col gap-4">
            <h1 class="flex items-center gap-3 font-heading text-5xl font-semibold leading-none sm:text-6xl">
                <twig:ux:icon name="lucide:sprout" class="size-12 text-primary sm:size-14" aria-hidden="true" />
                {{ 'home.title'|trans }}
            </h1>
            <p class="text-lg text-muted-foreground text-pretty">{{ 'home.lead'|trans }}</p>
        </header>

        {% for message in app.flashes('error') %}
            <twig:Alert variant="destructive" role="alert">
                <twig:Alert:Description>{{ message|trans }}</twig:Alert:Description>
            </twig:Alert>
        {% endfor %}

        {% set placeholder = 'home.placeholder'|trans %}
        {% set submit_label = 'home.submit'|trans %}
        <form method="post" action="{{ path('home_start') }}" class="flex flex-col gap-3 sm:flex-row" {{ stimulus_controller('form-submit-disable') }} data-action="submit->form-submit-disable#busy">
            {% set field = constant('App\\Controller\\PlaceSearch::FIELD') %}
            <twig:Label for="{{ field }}" class="sr-only">{{ 'home.label'|trans }}</twig:Label>
            <twig:InputGroup class="h-11 flex-1">
                <twig:InputGroup:Addon>
                    <twig:ux:icon name="lucide:map-pin" aria-hidden="true" />
                </twig:InputGroup:Addon>
                <twig:InputGroup:Input id="{{ field }}" name="{{ field }}" type="search" required autofocus autocomplete="off" placeholder="{{ placeholder }}" />
            </twig:InputGroup>
            <twig:Button type="submit" size="lg" class="h-11 px-4" data-form-submit-disable-target="button">
                {{ submit_label }}
                <twig:ux:icon name="lucide:arrow-right" aria-hidden="true" />
            </twig:Button>
        </form>

        <section aria-labelledby="schools-title" class="flex flex-col gap-2">
            <h2 id="schools-title" class="text-sm font-medium text-muted-foreground">{{ 'home.schools'|trans }}</h2>
            <ul class="grid gap-2 sm:grid-cols-3">
                {% for school in schools %}
                    <li>
                        <form method="post" action="{{ path('home_start') }}" class="h-full overflow-hidden rounded-lg" {{ stimulus_controller('form-submit-disable') }} data-action="submit->form-submit-disable#busy">
                            <input type="hidden" name="{{ constant('App\\Controller\\PlaceSearch::FIELD') }}" value="{{ school.place }}">
                            <button type="submit" class="group flex h-full w-full flex-col overflow-hidden rounded-lg border bg-card text-left transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-60" data-form-submit-disable-target="button">
                                <img src="{{ asset(school.image) }}" alt="{{ 'home.sample_alt'|trans({'%school%': school.value}) }}" width="900" height="563" loading="lazy" class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105">
                                <span class="flex flex-col gap-0.5 p-3">
                                    <span class="text-sm font-medium">{{ school.value }}</span>
                                    <span class="text-xs text-muted-foreground">{{ school.district }}</span>
                                </span>
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <section
            aria-labelledby="recent-title"
            class="flex flex-col gap-2"
            hidden
            {{ stimulus_controller('recent-plans', {storageKey: constant('App\\Controller\\HomeController::RECENT_PLANS_STORAGE_KEY')}) }}
            data-recent-plans-target="section"
        >
            <h2 id="recent-title" class="text-sm font-medium text-muted-foreground">{{ 'home.recent'|trans }}</h2>
            <twig:Item:Group class="gap-2" data-recent-plans-target="list" />
            <template data-recent-plans-target="template">
                <twig:Item variant="outline" size="sm" as="a" role="listitem" data-link>
                    <twig:Item:Media variant="icon"><twig:ux:icon name="lucide:map-pin" aria-hidden="true" /></twig:Item:Media>
                    <twig:Item:Content><twig:Item:Title class="line-clamp-1" data-text /></twig:Item:Content>
                    <twig:Item:Actions><twig:ux:icon name="lucide:arrow-right" class="size-4 text-muted-foreground" aria-hidden="true" /></twig:Item:Actions>
                </twig:Item>
            </template>
        </section>

        <p class="text-xs text-muted-foreground">{{ 'home.sources'|trans }}</p>
    </main>
{% endblock %}
