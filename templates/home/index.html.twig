{% extends 'base.html.twig' %}

{% block body %}
    <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-8 px-4 py-16">
        <header class="flex flex-col gap-3">
            <p class="flex items-center gap-2 font-mono text-sm text-primary">
                <twig:ux:icon name="lucide:sprout" class="size-4" aria-hidden="true" />
                SpongeCity AI
            </p>
            <h1 class="font-heading text-4xl font-semibold leading-tight text-balance">{{ 'home.title'|trans({}, 'spongecity') }}</h1>
            <p class="text-lg text-muted-foreground text-pretty">{{ 'home.lead'|trans({}, 'spongecity') }}</p>
        </header>

        {% for message in app.flashes('error') %}
            <twig:Alert variant="destructive" role="alert">
                <twig:Alert:Description>{{ message|trans({}, 'spongecity') }}</twig:Alert:Description>
            </twig:Alert>
        {% endfor %}

        {% set placeholder = 'home.placeholder'|trans({}, 'spongecity') %}
        {% set submit_label = 'home.submit'|trans({}, 'spongecity') %}
        <form method="post" action="{{ path('home') }}" class="flex flex-col gap-3 sm:flex-row" {{ stimulus_controller('form-submit-disable') }} data-action="submit->form-submit-disable#busy">
            <label for="place" class="sr-only">{{ 'home.label'|trans({}, 'spongecity') }}</label>
            <twig:Input id="place" name="place" type="search" required autofocus autocomplete="off" placeholder="{{ placeholder }}" class="h-11 flex-1" />
            <twig:Button type="submit" size="lg" data-form-submit-disable-target="button">
                {{ submit_label }}
                <twig:ux:icon name="lucide:arrow-right" aria-hidden="true" />
            </twig:Button>
        </form>

        <section aria-labelledby="examples-title" class="flex flex-col gap-2">
            <h2 id="examples-title" class="text-sm font-medium text-muted-foreground">{{ 'home.examples'|trans({}, 'spongecity') }}</h2>
            <ul class="flex flex-wrap gap-2">
                {% for example in examples %}
                    {% set text = example|trans({}, 'spongecity') %}
                    <li>
                        <twig:Button type="button" variant="outline" size="sm" data-controller="fill-input" data-action="fill-input#fill" data-fill-input-target-value="place" data-fill-input-text-value="{{ text }}">{{ text }}</twig:Button>
                    </li>
                {% endfor %}
            </ul>
        </section>
        <p class="text-xs text-muted-foreground">{{ 'home.sources'|trans({}, 'spongecity') }}</p>
    </main>
{% endblock %}
